{
  "name": "webradar",
  "private": true,
  "version": "2.0.0",
  "description": "Monitor en vivo de los sitios más usados en Guatemala: ¿está caído?",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 5182 --test-scheduled",
    "db:local": "wrangler d1 migrations apply webradar --local",
    "db:remote": "wrangler d1 migrations apply webradar --remote",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.40.0"
  }
}
